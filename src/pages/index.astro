---
// public/ assets are copied verbatim, so root-relative hrefs would 404 under `base`.
// BASE_URL has no trailing slash, so join explicitly.
const base = `${import.meta.env.BASE_URL}/`;
const favicon = `${base}favicon.svg`;
const fallback = `${base}favicon.ico`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={favicon} />
		<link rel="icon" href={fallback} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
	<body>
		<h1>Astro</h1>
	</body>
</html>
